<?xml version="1.0" encoding="utf-8"?>
<!-- Une entrée du menu de l'écran d'accueil : son titre, et la ligne de
     détail que l'écran visé peut fournir (l'avancement de la lecture). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/pj_wear_row"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/pj_row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pj_wear_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/pj_row_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pj_wear_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
