<?xml version="1.0" encoding="utf-8"?>
<!-- Un psaume, en hébreu, de droite à gauche. -->
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pj_wear_bg">

    <ScrollView
        android:id="@+id/pj_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:focusable="true"
        app:boxedEdges="all">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/pj_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/pj_wear_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pj_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.35"
                android:textColor="@color/pj_wear_text"
                android:textDirection="rtl"
                android:textAlignment="viewStart"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
