<?xml version="1.0" encoding="utf-8"?>
<!-- Un horaire : son nom à gauche, son heure à droite. Le premier de la liste
     est le prochain, et porte l'accent du thème. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/pj_zman_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pj_wear_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/pj_zman_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/pj_wear_text"
        android:textSize="14sp" />
</LinearLayout>
