<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'accueil de la montre : d'abord ce qu'on vient y chercher, le
     prochain horaire en grand, puis les trois écrans. Le BoxInsetLayout garde
     tout dans le carré inscrit d'un écran rond, où rien n'est rogné. -->
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pj_wear_bg">

    <ScrollView
        android:id="@+id/pj_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:focusable="true"
        app:boxedEdges="all">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/pj_hebrew_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/pj_wear_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pj_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/pj_wear_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pj_next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:maxLines="1"
                android:textColor="@color/pj_wear_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pj_next_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="34sp" />

            <!-- Aucun payload, ou fenêtre d'une semaine épuisée. -->
            <TextView
                android:id="@+id/pj_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/pj_wear_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/pj_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
