<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Série de jours » : la flamme et le compteur côte à côte, en
     grand, « jours d'affilée » dessous, puis le record. Le dessin du bandeau
     du profil (src/components/DailyStreakStats.vue), dans la plus petite
     tuile. La flamme porte l'accent du thème quand la série est en cours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pj_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pj_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/pj_streak_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/pj_widget_streak_label"
        android:textColor="@color/pj_widget_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pj_streak_flame"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:src="@drawable/pj_widget_flame" />

        <TextView
            android:id="@+id/pj_streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/pj_widget_text"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/pj_streak_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/pj_widget_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/pj_streak_best"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/pj_widget_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
