<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Lecture du jour » : une ligne, le dessin de la carte du tableau
     de bord (src/components/DailyReadingCard.vue) : titre et chevron, ligne de
     progression et pourcentage, barre. Le pourcentage, la barre et l'icône
     portent l'accent du thème de l'utilisateur, qui arrive dans le payload.
     Les écarts sont ceux de la carte (16 dp sous le titre, 8 au-dessus de la
     barre) ; les corps, eux, sont ceux d'un widget, plus grands que sur la
     carte, et les mêmes que sur iOS : à trois lignes fines, la tuile sonnait
     vide. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pj_lecture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pj_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pj_lecture_icon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:src="@drawable/pj_widget_book" />

        <TextView
            android:id="@+id/pj_lecture_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/pj_widget_lecture_label"
            android:textColor="@color/pj_widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/pj_lecture_chevron"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/pj_widget_chevron" />
    </LinearLayout>

    <!-- L'état mesurable : « 2 sur 3 lus aujourd'hui » et son pourcentage. -->
    <LinearLayout
        android:id="@+id/pj_lecture_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pj_lecture_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pj_widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pj_lecture_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barre dessinée par le provider (bitmap) : RemoteViews ne sait teindre
         ni un ProgressBar ni un fond arrondi à une couleur venue du payload. -->
    <ImageView
        android:id="@+id/pj_lecture_bar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <!-- Rien à mesurer (liste non composée, payload absent) : un mot suffit. -->
    <TextView
        android:id="@+id/pj_lecture_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/pj_widget_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
