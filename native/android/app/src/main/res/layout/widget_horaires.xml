<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Horaires », petit format (moins de quatre colonnes) : le jour
     hébraïque, le prochain zman (à l'accent du thème de l'utilisateur, comme
     la carte « prochain horaire » de la page Horaires), l'horaire d'après, la
     paracha et le tahanoun. Le pendant du .systemSmall d'iOS, dont il reprend
     les corps et l'ordre ; le format large a son propre gabarit
     (widget_horaires_medium.xml), avec les mêmes identifiants.
     Couleurs jour/nuit via values(-night). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pj_horaires_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pj_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pj_horaires_hebrew_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pj_widget_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pj_horaires_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pj_widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pj_horaires_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/pj_widget_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/pj_horaires_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/pj_widget_text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Les horaires d'après, posés dans la place que le prochain laisse libre
         (poids 1, alignés en bas) : la hauteur du widget se remplit au lieu de
         finir sur du vide. Widget trop court : la zone tombe à zéro et les
         lignes disparaissent d'elles-mêmes. Le petit format n'en montre qu'un,
         les deux autres lignes existent pour que les deux gabarits portent les
         mêmes identifiants. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="vertical">

        <!-- Horaire suivant 1 : son libellé à gauche, son heure à droite. -->
        <LinearLayout
            android:id="@+id/pj_horaires_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pj_horaires_next_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pj_widget_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pj_horaires_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/pj_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Horaire suivant 2 : son libellé à gauche, son heure à droite. -->
        <LinearLayout
            android:id="@+id/pj_horaires_next2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pj_horaires_next2_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pj_widget_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pj_horaires_next2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/pj_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Horaire suivant 3 : son libellé à gauche, son heure à droite. -->
        <LinearLayout
            android:id="@+id/pj_horaires_next3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pj_horaires_next3_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pj_widget_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pj_horaires_next3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/pj_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pj_horaires_parasha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pj_widget_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/pj_horaires_tachanun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pj_widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
