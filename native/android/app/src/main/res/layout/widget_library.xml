<?xml version="1.0" encoding="utf-8"?>
<!-- Raccourci « Bibliothèque » : le titre, puis l'étagère, dessinée par le
     provider (WidgetGraphics) faute de savoir composer en RemoteViews des
     dégradés, des filets et un titre écrit sur une couverture. Le petit
     format montre trois volumes muets, le format large quatre volumes
     titrés, comme sur iOS. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pj_library_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pj_widget_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/pj_library_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/pj_widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/pj_library_shelf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />
</LinearLayout>
