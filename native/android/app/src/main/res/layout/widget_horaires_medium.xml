<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Horaires », format large (quatre colonnes et plus), pendant du
     .systemMedium d'iOS : ce qu'il a en trop est de la largeur, les horaires
     suivants vont donc À CÔTÉ de l'heure mise en avant, pas dessous. Les
     empiler y ferait déborder le bloc, la date se collant au bord du haut et
     le tahanoun se coupant en bas.
     Mêmes identifiants que widget_horaires.xml : le provider remplit les deux
     gabarits du même code, seul le nombre d'horaires suivants change. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pj_horaires_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pj_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pj_horaires_hebrew_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pj_widget_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pj_horaires_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pj_widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- L'heure mise en avant : son nom, puis l'heure à l'accent du thème. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pj_horaires_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/pj_widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pj_horaires_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/pj_widget_text"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Les horaires d'après, en colonne à droite : ils occupent la
             largeur que le format large a en trop. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="3"
            android:orientation="vertical">
            <!-- Horaire suivant 1 : son libellé à gauche, son heure à droite. -->
            <LinearLayout
                android:id="@+id/pj_horaires_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pj_horaires_next_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pj_widget_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pj_horaires_next_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="@color/pj_widget_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Horaire suivant 2 : son libellé à gauche, son heure à droite. -->
            <LinearLayout
                android:id="@+id/pj_horaires_next2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pj_horaires_next2_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pj_widget_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pj_horaires_next2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="@color/pj_widget_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Horaire suivant 3 : son libellé à gauche, son heure à droite. -->
            <LinearLayout
                android:id="@+id/pj_horaires_next3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pj_horaires_next3_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pj_widget_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pj_horaires_next3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="@color/pj_widget_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pj_horaires_parasha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pj_widget_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/pj_horaires_tachanun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pj_widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
