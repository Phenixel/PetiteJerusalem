{
  "title": "ברכה אחרונה (Brakha A'harona)",
  "blocks": [
    {
      "label": "Mé'ein chaloch (Al hami'hya)",
      "lines": [
        "בָּרוּךְ אַתָּה יְהֹוָה, אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם",
        {
          "rubric": {
            "fr": "Après des mezonot :",
            "en": "After mezonot:",
            "he": "אם אכל מזונות יאמר:"
          },
          "he": "עַל הַמִּחְיָה וְעַל הַכַּלְכָּלָה"
        },
        {
          "rubric": {
            "fr": "Après du vin :",
            "en": "After wine:",
            "he": "אם שתה יין יאמר:"
          },
          "he": "(וְ)עַל הַגֶּֽפֶן וְעַל פְּרִי הַגֶּֽפֶן"
        },
        {
          "rubric": {
            "fr": "Après un des sept fruits :",
            "en": "After one of the seven fruits:",
            "he": "אם אכל פרות משבעת המינים יאמר:"
          },
          "he": "(וְ)עַל הָעֵץ וְעַל פְּרִי הָעֵץ"
        },
        "וְעַל תְּנוּבַת הַשָּׂדֶה, וְעַל אֶֽרֶץ חֶמְדָּה טוֹבָה וּרְחָבָה, שֶׁרָצִֽיתָ וְהִנְחַֽלְתָּ לַאֲבוֹתֵֽינוּ, לֶאֱכֹל מִפִּרְיָהּ וְלִשְׂבֹּֽעַ מִטּוּבָהּ. רַחֵם יְהֹוָה אֱלֹהֵֽינוּ עָלֵֽינוּ וְעַל יִשְׂרָאֵל עַמָּךְ, וְעַל יְרוּשָׁלַֽיִם עִירָךְ, וְעַל הַר צִיּוֹן מִשְׁכַּן כְּבוֹדָךְ, וְעַל מִזְבָּחָךְ וְעַל הֵיכָלָךְ. וּבְנֵה יְרוּשָׁלַֽיִם עִיר הַקֹּֽדֶשׁ בִּמְהֵרָה בְיָמֵֽינוּ, וְהַעֲלֵֽנוּ לְתוֹכָהּ, וְשַׂמְּחֵֽנוּ בְּבִנְיָנָהּ, וּנְבָֽרְכָֽךְ עָלֶֽיהָ בִּקְדֻשָּׁה וּבְטָהֳרָה:",
        {
          "rubric": {
            "fr": "(le Chabbat)",
            "en": "(on Shabbat)",
            "he": "(בשבת)"
          },
          "he": "וּרְצֵה וְהַחֲלִיצֵֽנוּ בְּיוֹם הַשַּׁבָּת הַזֶּה."
        },
        {
          "rubric": {
            "fr": "À Roch 'Hodech :",
            "en": "On Rosh Chodesh:",
            "he": "בראש חדש:"
          },
          "he": "וְזָכְרֵֽנוּ לְטוֹבָה בְּיוֹם רֹאשׁ חֹֽדֶשׁ הַזֶּה."
        },
        {
          "rubric": {
            "fr": "À Roch Hachana :",
            "en": "On Rosh Hashanah:",
            "he": "בראש השנה:"
          },
          "he": "וְזָכְרֵֽנוּ לְטוֹבָה בְּיוֹם הַזִּכָּרוֹן הַזֶּה."
        },
        {
          "rubric": {
            "fr": "À Pessa'h :",
            "en": "On Pesach:",
            "he": "בפסח:"
          },
          "he": [
            "וְשַׂמְּחֵֽנוּ בְּיוֹם חַג הַמַּצּוֹת הַזֶּה, בְּיוֹם",
            {
              "r": {
                "fr": "(un jour de fête, on ajoute)",
                "en": "(on Yom Tov add)",
                "he": "(ביום טוב מוסיפים)"
              }
            },
            "טוֹב מִקְרָא קֹדֶשׁ הַזֶּה."
          ]
        },
        {
          "rubric": {
            "fr": "À Chavouot :",
            "en": "On Shavuot:",
            "he": "בשבועות:"
          },
          "he": "וְשַׂמְּחֵֽנוּ בְּיוֹם חַג הַשָּׁבוּעוֹת הַזֶּה בְּיוֹם טוֹב מִקְרָא קֹֽדֶשׁ הַזֶּה."
        },
        {
          "rubric": {
            "fr": "À Souccot :",
            "en": "On Sukkot:",
            "he": "בסוכות:"
          },
          "he": [
            "וְשַׂמְּחֵֽנוּ בְּיוֹם הַסֻּכּוֹת הַזֶּה, בְּיוֹם",
            {
              "r": {
                "fr": "(un jour de fête, on ajoute)",
                "en": "(on Yom Tov add)",
                "he": "(ביום טוב מוסיפים)"
              }
            },
            "טוֹב מִקְרָא קֹֽדֶשׁ הַזֶּה."
          ]
        },
        {
          "rubric": {
            "fr": "À Chemini Atséret :",
            "en": "On Shemini Atzeret:",
            "he": "בשמיני עצרת:"
          },
          "he": "וְשַׂמְּחֵֽנוּ בְּיוֹם שְׁמִינִי חַג עֲצֶֽרֶת הַזֶּה בְּיוֹם טוֹב מִקְרָא קֹֽדֶשׁ הַזֶּה."
        },
        "כִּי אַתָּה טוֹב וּמֵטִיב לַכֹּל, וְנוֹדֶה לְךָ עַל הָאָֽרֶץ",
        {
          "rubric": {
            "fr": "mezonot :",
            "en": "mezonot:",
            "he": "מזונות:"
          },
          "he": [
            "וְעַל הַמִּחְיָה וְעַל הַכַּלְכָּלָה",
            {
              "r": {
                "fr": "(en Terre d'Israël)",
                "en": "(in the Land of Israel)",
                "he": "(של ארץ ישראל)"
              }
            },
            "וְעַל מִחְיָתָהּ וְעַל כַּלְכָּלָתָהּ"
          ]
        },
        {
          "rubric": {
            "fr": "vin :",
            "en": "wine:",
            "he": "יין:"
          },
          "he": [
            "וְעַל פְּרִי הַגֶּֽפֶן",
            {
              "r": {
                "fr": "(en Terre d'Israël)",
                "en": "(in the Land of Israel)",
                "he": "(של ארץ ישראל)"
              }
            },
            "וְעַל פְּרִי גַפְנָהּ"
          ]
        },
        {
          "rubric": {
            "fr": "fruits :",
            "en": "fruit:",
            "he": "פירות:"
          },
          "he": [
            "וְעַל הַפֵּרוֹת",
            {
              "r": {
                "fr": "(en Terre d'Israël)",
                "en": "(in the Land of Israel)",
                "he": "(של ארץ ישראל)"
              }
            },
            "וְעַל פֵּרוֹתֶֽיהָ"
          ]
        },
        "בָּרוּךְ אַתָּה יְהֹוָה, עַל הָאָֽרֶץ וְעַל",
        {
          "rubric": {
            "fr": "mezonot :",
            "en": "mezonot:",
            "he": "מזונות:"
          },
          "he": [
